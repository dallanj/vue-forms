{
    "name": "@dallanj/vue-forms",
    "version": "0.3.0",
    "description": "Accessible, framework-neutral Vue form fields with optional Inertia integration",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/dallanj/vue-forms.git"
    },
    "bugs": {
        "url": "https://github.com/dallanj/vue-forms/issues"
    },
    "homepage": "https://github.com/dallanj/vue-forms#readme",
    "keywords": [
        "vue",
        "forms",
        "inputs",
        "validation",
        "inertia",
        "laravel"
    ],
    "engines": {
        "node": ">=20"
    },
    "type": "module",
    "files": [
        "dist",
        "src/scss"
    ],
    "sideEffects": [
        "**/*.css",
        "**/*.scss"
    ],
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/types/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/types/index.d.ts",
            "import": "./dist/index.js"
        },
        "./inertia": {
            "types": "./dist/types/inertia.d.ts",
            "import": "./dist/inertia.js"
        },
        "./style.css": "./dist/style.css",
        "./scss": "./src/scss/index.scss"
    },
    "scripts": {
        "build": "npm run build:css && vite build && vue-tsc -p tsconfig.build.json",
        "test": "vitest run",
        "typecheck": "vue-tsc --noEmit",
        "check": "npm run typecheck && npm test && npm run build",
        "prepublishOnly": "npm run check",
        "build:css": "node scripts/build-css.mjs"
    },
    "publishConfig": {
        "access": "public"
    },
    "peerDependencies": {
        "vue": "^3.5.0"
    },
    "devDependencies": {
        "@vitejs/plugin-vue": "^6.0.0",
        "@vue/test-utils": "^2.4.6",
        "jsdom": "^26.0.0",
        "sass": "^1.86.0",
        "typescript": "^5.7.0",
        "vite": "^7.0.0",
        "vitest": "^3.2.0",
        "vue": "^3.5.0",
        "vue-tsc": "^2.2.0"
    }
}
